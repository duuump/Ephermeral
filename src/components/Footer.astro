---
const built = new Date().toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---
<footer>Ostatnia aktualizacja: {built}</footer>
<style>
  footer { padding: 48px 24px 32px; font-size: 13px; color: var(--muted); }
  @media (max-width: 600px) { footer { padding: 40px 16px 24px; } }
</style>
